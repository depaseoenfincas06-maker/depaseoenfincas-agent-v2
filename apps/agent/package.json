{
  "name": "@depf/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "worker": "tsx watch src/workers/message-worker.ts",
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "start:worker": "node dist/workers/message-worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/persistence/migrate.ts up",
    "db:rollback": "tsx src/persistence/migrate.ts down",
    "db:seed": "tsx src/persistence/seed.ts",
    "evals": "tsx src/evals/run.ts"
  },
  "dependencies": {
    "@depf/shared": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.2",
    "@google/generative-ai": "^0.21.0",
    "bullmq": "^5.34.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "vitest": "^2.1.8"
  }
}
