# ----- Server -----
NODE_ENV=development
LOG_LEVEL=info
AGENT_HTTP_PORT=3200
DASHBOARD_PORT=3201

# ----- Postgres (Supabase or local) -----
DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require
DATABASE_POOL_MAX=10

# ----- Redis (BullMQ) -----
REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=5

# ----- LLM provider -----
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional fallback provider:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ----- OpenAI (transcription) -----
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_TRANSCRIPTION_FALLBACK_MODEL=whisper-1

# ----- Chatwoot -----
CHATWOOT_BASE_URL=https://chatwoot-9qe1j-u48275.vm.elestio.app
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=
CHATWOOT_INBOX_ID=

# ----- Meta WhatsApp Cloud API -----
# Client-facing number (main agent), e.g. +57 310 5639334
WHATSAPP_PHONE_NUMBER_ID=
# Owner-facing number, used to verify finca availability with owners
WHATSAPP_OWNER_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ----- Inventory (Google Sheets) -----
INVENTORY_SHEET_DOCUMENT_ID=
INVENTORY_SHEET_TAB_NAME=fincas_inventory_ajustada_real
GOOGLE_SERVICE_ACCOUNT_JSON=

# ----- Webhook secrets / auth -----
WEBHOOK_SHARED_SECRET=
DASHBOARD_BASIC_AUTH_USER=admin
DASHBOARD_BASIC_AUTH_PASSWORD=

# ----- Observability -----
SENTRY_DSN=
